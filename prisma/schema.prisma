// Multi-tenant SaaS schema for invoice extraction (AWS Textract).
// Swap DATABASE_URL to a Postgres URL for production (schema is provider-agnostic).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. On Neon, set this to
  // the non-pooler endpoint. Can equal DATABASE_URL for non-Neon setups.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("free") // free | pro | enterprise
  monthlyLimit Int     @default(50)     // max invoices processed per month
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  invoices Invoice[]
  usage    UsageRecord[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  role           String   @default("member") // owner | admin | member
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // File metadata
  fileName  String
  mimeType  String
  sizeBytes Int
  storageKey String // local relative path or S3 object key
  storage   String  @default("local") // local | s3

  // Processing
  status      String  @default("pending") // pending | processing | completed | failed
  errorMessage String?
  pageCount   Int?
  confidence  Float?

  // Extracted summary fields
  vendorName    String?
  vendorAddress String?
  vendorTaxId   String?
  invoiceNumber String?
  invoiceDate   String?
  dueDate       String?
  currency      String?
  subtotal      Float?
  tax           Float?
  total         Float?
  paymentTerms  String?

  rawJson String? // full normalized Textract response for audit / re-parsing

  // Duplicate detection
  contentHash   String?  // sha256 of original file bytes
  duplicate     Boolean  @default(false)
  duplicateOfId String?  // id of the invoice this is a suspected duplicate of

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  usageRecord UsageRecord?
  file       InvoiceFile?

  @@index([organizationId, createdAt])
  @@index([organizationId, contentHash])
  @@index([organizationId, vendorName, invoiceNumber])
}

// Original document bytes. Used when AWS_S3_BUCKET is not configured
// (files stored in Postgres bytea). Free-tier friendly, no S3 setup needed.
model InvoiceFile {
  invoiceId String   @id
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bytes     Bytes
  createdAt DateTime @default(now())
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String?
  quantity    Float?
  unitPrice   Float?
  amount      Float?
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String   @unique
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  pages     Int
  costCents Int // internal cost estimate in cents
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}
