// Multi-tenant SaaS schema for invoice extraction (AWS Textract).
// Swap DATABASE_URL to a Postgres URL for production (schema is provider-agnostic).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. On Neon, set this to
  // the non-pooler endpoint. Can equal DATABASE_URL for non-Neon setups.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("free") // free | pro | enterprise
  monthlyLimit Int     @default(50)     // max invoices processed per month
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  invoices      Invoice[]
  usage         UsageRecord[]
  documentTypes DocumentType[]
  documents     Document[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  role           String   @default("member") // owner | admin | member
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices           Invoice[]
  reviewedInvoices   Invoice[] @relation("InvoiceReviewer")
  documents          Document[] @relation("DocumentUploader")
  reviewedDocuments  Document[] @relation("DocumentReviewer")
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // File metadata
  fileName  String
  mimeType  String
  sizeBytes Int
  storageKey String // local relative path or S3 object key
  storage   String  @default("local") // local | s3

  // Processing
  status      String  @default("pending") // pending | processing | completed | failed
  errorMessage String?
  pageCount   Int?
  confidence  Float?

  // Extracted summary fields
  vendorName    String?
  vendorAddress String?
  vendorTaxId   String?
  invoiceNumber String?
  invoiceDate   String?
  dueDate       String?
  currency      String?
  subtotal      Float?
  tax           Float?
  total         Float?
  paymentTerms  String?

  rawJson String? // full normalized Textract response for audit / re-parsing

  // Duplicate detection
  contentHash   String?  // sha256 of original file bytes
  duplicate     Boolean  @default(false)
  duplicateOfId String?  // id of the invoice this is a suspected duplicate of

  // Review / approval workflow
  reviewedById String?    // who approved (null = system auto-approve)
  reviewedBy   User?      @relation("InvoiceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewStatus String  @default("needs_review") // needs_review | approved
  reviewReason String?    // why it needs review (duplicate / low confidence / missing fields)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  usageRecord UsageRecord?
  file       InvoiceFile?

  @@index([organizationId, createdAt])
  @@index([organizationId, contentHash])
  @@index([organizationId, vendorName, invoiceNumber])
}

// Original document bytes. Used when AWS_S3_BUCKET is not configured
// (files stored in Postgres bytea). Free-tier friendly, no S3 setup needed.
model InvoiceFile {
  invoiceId String   @id
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bytes     Bytes
  createdAt DateTime @default(now())
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String?
  quantity    Float?
  unitPrice   Float?
  amount      Float?
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String   @unique
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  pages     Int
  costCents Int // internal cost estimate in cents
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ---------- Generic document extraction (multi-sector) ----------

model DocumentType {
  id              String   @id @default(cuid())
  organizationId  String?  // null = shared preset available to all orgs
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Aerospace Part Certificate"
  description     String?
  extractionMethod String  @default("queries") // queries | expense
  slug            String?  // stable identifier for presets
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fields    DocumentField[]
  documents Document[]

  @@index([organizationId])
}

model DocumentField {
  id            String   @id @default(cuid())
  documentTypeId String
  documentType  DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  key           String   // e.g. "part_number"
  label         String   // e.g. "Part number"
  method        String   @default("query") // query | form | table | regex
  question      String?  // natural-language question for method=query
  fieldType     String   @default("string") // string | number | date
  required      Boolean  @default(false)
  sortOrder     Int      @default(0)

  @@index([documentTypeId])
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  // File metadata
  fileName  String
  mimeType  String
  sizeBytes Int
  storageKey String
  storage   String  @default("db") // db | s3

  // Processing
  status       String  @default("pending") // pending | processing | completed | failed
  errorMessage String?
  pageCount    Int?
  confidence   Float?
  rawJson      String? // full Textract response for audit / re-parsing

  // Review workflow
  reviewedById String?
  reviewedBy   User?    @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewStatus String  @default("needs_review") // needs_review | approved
  reviewReason String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values DocumentValue[]
  file   DocumentFile?

  @@index([organizationId, createdAt])
}

// Original document bytes when storage = "db" (Postgres bytea).
model DocumentFile {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  bytes      Bytes
  createdAt  DateTime @default(now())
}

model DocumentValue {
  id         String  @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fieldKey   String  // matches DocumentField.key
  label      String
  value      String?
  confidence Float?
  page       Int     @default(1)
  left       Float?
  top        Float?
  width      Float?
  height     Float?
  sortOrder  Int     @default(0)

  @@index([documentId])
}
