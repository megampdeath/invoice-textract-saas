# ---- App ----
# Generate with: openssl rand -base64 32 (or `next auth secret` via npx)
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---- AWS Textract ----
# IAM user needs `textract:AnalyzeExpense` (and `textract:DetectDocumentText` optional).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: S3 storage for uploaded files. Leave EMPTY to store files in
# Postgres (bytea) — simplest for the free-tier deploy, no S3/IAM setup.
AWS_S3_BUCKET=

# Secret for signing public preview/share tokens (generate a long random hex)
PREVIEW_TOKEN_SECRET=

# ---- Database (Postgres) ----
# Neon (recommended, free): use the POOLED connection string here.
# e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=
# Non-pooled (direct) connection for migrations (Neon: the non-pooler endpoint).
DIRECT_DATABASE_URL=
